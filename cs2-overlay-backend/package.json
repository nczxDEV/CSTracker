{
  "name": "cs2-overlay-backend",
  "version": "0.2.0",
  "description": "Backend API gateway for the CS Tracker desktop stats overlay (FACEIT + Steam Web API, cache, rate limiting, SQLite, GSI).",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "build:bundle": "tsc -p tsconfig.json --outDir dist-tsc && esbuild dist-tsc/main.js --bundle --platform=node --target=node22 --format=cjs --external:node:sqlite --external:@nestjs/microservices --external:@nestjs/microservices/microservices-module --external:@nestjs/websockets --external:@nestjs/websockets/socket-module --external:class-transformer/storage --outfile=dist/bundle.cjs",
    "build:sidecar": "node scripts/build-sidecar.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/cache-manager": "^2.2.1",
    "cache-manager": "^5.5.1",
    "cache-manager-redis-store": "^3.0.1",
    "axios": "^1.6.8",
    "rxjs": "^7.8.1",
    "reflect-metadata": "^0.2.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "globals": {
      "ts-jest": {
        "tsconfig": "<rootDir>/../tsconfig.json"
      }
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/node_modules/", "/dist/"]
  }
}

