# WARNING: never commit your real .env file!
# API keys are only ever stored in the backend, the desktop client never
# has direct access to them.
#
# NEW: you no longer HAVE to edit this file by hand! API keys entered in
# the launcher's (Control Panel) "Settings" / Setup Wizard screen are
# saved to the local SQLite database and override the values set here.
# This file is intended for advanced/dev/CI use.

PORT=3000
# Only bind to localhost - do NOT change this to 0.0.0.0 unless you know
# exactly what you're doing.
HOST=127.0.0.1

# Obtainable from the FACEIT Developer Portal, review the ToS: https://developers.faceit.com
FACEIT_API_KEY=your_faceit_api_key_here
FACEIT_API_BASE_URL=https://open.faceit.com/data/v4

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here
STEAM_API_BASE_URL=https://api.steampowered.com

# Leetify Public CS API - official, documented API (leetify.com/app/developer).
# Get your own key there, then either paste it here OR (recommended) enter
# it via the Setup Wizard in the Control Panel. Left empty, LeetifyClient
# returns "N/A" everywhere. LEETIFY_API_BASE_URL only needs overriding for
# advanced/testing use - it already defaults to Leetify's real API.
LEETIFY_API_KEY=
LEETIFY_API_BASE_URL=https://api-public.cs-prod.leetify.com

# "Bejelentkezés FACEIT-tel" (AuthModule) - FACEIT Connect OAuth2 client
# credentials, created ONCE in the FACEIT Developer Portal (App Studio ->
# your app -> OAuth2 Clients -> Create). These belong to the CS Tracker
# APP ITSELF (baked into the shipped build), NOT entered by each end user
# - unlike FACEIT_API_KEY above. See BUILD.md "FACEIT OAuth setup".
FACEIT_OAUTH_CLIENT_ID=
FACEIT_OAUTH_CLIENT_SECRET=
# Must exactly match the Redirect URI registered on the OAuth2 Client.
# FACEIT requires an https:// redirect URI even for local development -
# see BUILD.md for the redirectmeto.com-based workaround (quick to set up
# for testing) and how to replace it with a self-hosted redirect page
# before shipping to real end users.
FACEIT_OAUTH_REDIRECT_URI=https://redirectmeto.com/http://localhost:3000/auth/faceit/callback
# Only override these if FACEIT changes their OAuth endpoints - see
# configuration.ts for the documented defaults.
FACEIT_OAUTH_AUTHORIZE_URL=
FACEIT_OAUTH_TOKEN_URL=
FACEIT_OAUTH_USERINFO_URL=

# Single SQLite file for the notes / saved-players / settings (API keys,
# GSI token) tables. Uses Node.js's built-in `node:sqlite` module - no
# native addon compilation required.
DATABASE_PATH=./data/app.db

# Cache
CACHE_TTL_SECONDS=600
REDIS_URL=redis://localhost:6379

# Rate limit (towards clients, on the backend gateway)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

# CORS allow-list (comma-separated) - only the Tauri client's origins are
# allowed by default, do NOT open this up to arbitrary sites.
#
# NOTE: the PACKAGED Tauri v2 app uses an internal origin that is NOT
# `http://localhost`:
#   - Windows:      https://tauri.localhost  (and http://tauri.localhost)
#   - macOS/Linux:  tauri://localhost
# All of these MUST stay in the list, otherwise the Control Panel's
# requests are blocked by CORS and the UI reports "backend unreachable".
CORS_ALLOWED_ORIGINS=tauri://localhost,https://tauri.localhost,http://tauri.localhost,http://localhost:1420,http://localhost:5173,http://localhost:3000
