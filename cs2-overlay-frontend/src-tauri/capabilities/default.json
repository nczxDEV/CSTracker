{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Base permissions for the launcher (Control Panel) window: sidecar (backend) startup, window-state persistence, auto-update (check/download/install + relaunch), native save-file dialog.",
  "windows": ["launcher"],
  "permissions": [
    "core:default",
    "window-state:default",
    "updater:default",
    "process:default",
    "dialog:default",
    "opener:default",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "http://localhost:3000/auth/steam/login" },
      { "url": "http://localhost:3000/auth/faceit/login" }
    ] },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/cs2-overlay-backend",
          "sidecar": true,
          "args": false
        }
      ]
    }
  ]
}
