{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CS Tracker",
  "version": "0.2.0",
  "identifier": "com.cstracker.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "CS Tracker - Control Panel",
        "url": "launcher.html",
        "width": 1180,
        "height": 860,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3000 http://localhost:3000 ipc: http://ipc.localhost; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "externalBin": ["binaries/cs2-overlay-backend"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/YOUR_GITHUB_USERNAME/YOUR_REPO_NAME/releases/latest/download/latest.json"
      ],
      "pubkey": "PASTE_YOUR_GENERATED_PUBLIC_KEY_HERE",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
